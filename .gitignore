# Public source, tests and installation scripts.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/LICENSE
!/pyproject.toml
!/install.sh
!/install.ps1
!/install-macos.sh
!/reinstall.sh
!/uninstall.sh
!/uninstall.ps1
!/uninstall-macos.sh
!/mediacraft/
!/tests/
!/examples/

# Files allowed inside the source directories.
/mediacraft/*
!/mediacraft/*.py
/tests/*
!/tests/*.py
/examples/*
!/examples/sample.svg
!/examples/test_media/
/examples/test_media/*
!/examples/test_media/sample_layers.svg
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/.github/workflows/*.yaml

# Local Python artifacts.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
