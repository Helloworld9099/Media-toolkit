# Track only the public application source and installers.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/install.sh
!/install.ps1
!/install-macos.sh
!/reinstall.sh
!/uninstall.sh
!/uninstall.ps1
!/uninstall-macos.sh
!/mediacraft/
!/examples/

/mediacraft/*
!/mediacraft/*.py
/examples/*
!/examples/sample.svg

# Ignore development and local artifacts.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
